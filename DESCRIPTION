Package: Ruido
Title: Soundscape Spectral Metrics
Version: 1.1.0
Date: 2026-9-1
Authors@R: c(
    person(given = "Arthur Igor da", family = "Fonseca-Freire", email = "arthur.igorr@gmail.com", role = c("aut", "cre", "cph")),
